+    def predict_with_descriptions(
+        self, image, queries,
+        box_threshold=0.2,
+        text_mode="description",
+    ):
+        """Run full-image queries with explicit target-token alignment."""
+        if text_mode not in {"name_only", "description"} or not queries:
+            raise ValueError("Invalid text mode or empty queries")
+
+        if not getattr(self.model.tokenizer, "is_fast", False):
+            raise RuntimeError("Target spans require a fast tokenizer")
+
+        processed = Model.preprocess_image(
+            image_bgr=image
+        ).to(self.device)
+
+        all_boxes, all_scores = [], []
+        all_features, all_classes = [], []
+        records, seen = [], set()
+
+        for class_id, query in enumerate(queries):
+            query_id = str(query["query_id"])
+            if query_id in seen:
+                raise ValueError(f"Duplicate query_id: {query_id}")
+            seen.add(query_id)
+
+            name = " ".join(query["name"].lower().split())
+            description = " ".join(
+                query["description"].lower().split()
+            )
+
+            if not name or (
+                text_mode == "description" and not description
+            ):
+                raise ValueError(
+                    f"Empty target or description: {query_id}"
+                )
+
+            # The description conditions the network, while the leading
+            # target name determines which token scores select boxes.
+            caption = (
+                name if text_mode == "name_only"
+                else f"{name}: {description}"
+            )
+            caption = preprocess_caption(caption)
+
+            tokenized = self.model.tokenizer(
+                caption,
+                return_offsets_mapping=True,
+                truncation=False,
+            )
+
+            limit = int(getattr(self.model, "max_text_len", 256))
+            if len(tokenized["input_ids"]) > limit:
+                raise ValueError(
+                    f"Query {query_id} exceeds {limit} tokens"
+                )
+
+            target_tokens = [
+                i
+                for i, (start, end) in enumerate(
+                    tokenized["offset_mapping"]
+                )
+                if end > start
+                and start < len(name)
+                and end > 0
+                and any(
+                    c.isalnum()
+                    for c in caption[start:min(end, len(name))]
+                )
+            ]
+            if not target_tokens:
+                raise ValueError(f"No target tokens: {query_id}")
+
+            captured = []
+
+            def capture_decoder(module, inputs, output):
+                captured.append(output[0][-1].detach())
+
+            hook = self.model.transformer.register_forward_hook(
+                capture_decoder
+            )
+            try:
+                with torch.no_grad():
+                    output = self.model(
+                        processed[None], captions=[caption]
+                    )
+            finally:
+                hook.remove()
+
+            if len(captured) != 1:
+                raise RuntimeError(
+                    "Expected one decoder feature capture"
+                )
+
+            logits = (
+                output["pred_logits"][0]
+                .detach().cpu().sigmoid()
+            )
+            boxes = output["pred_boxes"][0].detach().cpu()
+            features = captured[0][0].cpu()
+
+            if (
+                len(features) != len(boxes)
+                or len(logits) != len(boxes)
+            ):
+                raise RuntimeError(
+                    "Boxes, logits and features are misaligned"
+                )
+            if max(target_tokens) >= logits.shape[1]:
+                raise RuntimeError(
+                    "Target token was truncated by the detector"
+                )
+
+            target_scores = logits[
+                :, target_tokens
+            ].max(dim=1).values
+
+            global_scores = logits.max(dim=1).values
+
+            keep = (
+                (target_scores > box_threshold)
+                & torch.isfinite(target_scores)
+                & torch.isfinite(boxes).all(dim=1)
+                & (boxes[:, 2:] > 0).all(dim=1)
+            )
+            indices = torch.nonzero(
+                keep, as_tuple=False
+            ).flatten().tolist()
+
+            # Apply exactly the same selection to boxes and features.
+            all_boxes.append(boxes[keep])
+            all_scores.append(target_scores[keep])
+            all_features.append(features[keep])
+            all_classes.extend([class_id] * len(indices))
+
+            tokens = self.model.tokenizer.convert_ids_to_tokens(
+                tokenized["input_ids"]
+            )
+
+            for raw_index in indices:
+                records.append({
+                    "query_id": query_id,
+                    "dino_query_index": raw_index,
+                    "text_mode": text_mode,
+                    "grounding_caption": caption,
+                    "target_token_indices": target_tokens,
+                    "target_tokens": [
+                        tokens[i] for i in target_tokens
+                    ],
+                    "detector_score": float(
+                        target_scores[raw_index]
+                    ),
+                    "global_token_max": float(
+                        global_scores[raw_index]
+                    ),
+                })
+
+        boxes = torch.cat(all_boxes, dim=0)
+        scores = torch.cat(all_scores, dim=0)
+        features = torch.cat(all_features, dim=0)
+
+        height, width = image.shape[:2]
+        detections = Model.post_process_result(
+            height, width, boxes, scores
+        )
+        detections.class_id = np.asarray(
+            all_classes, dtype=np.int64
+        )
+
